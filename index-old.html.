<!doctype html>
<html lang="uk">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>STUDY HOME — ПДР і затишний дім</title>
<style>
:root{font-family:system-ui,-apple-system,sans-serif;color:#443f56;background:#fff7f6}*{box-sizing:border-box}body{margin:0}.app{max-width:540px;margin:auto;padding:20px 16px 100px}.top{display:flex;justify-content:space-between;align-items:center;gap:10px}.logo{font-size:25px;font-weight:900;color:#7259a5}.tag{font-size:12px;color:#9385a4}.wallet{border-radius:22px;background:white;padding:10px 13px;box-shadow:0 6px 22px #b79db626;font-weight:800}.hero{background:linear-gradient(135deg,#e5dcff,#ffe0e8);border-radius:28px;margin:22px 0;padding:22px;box-shadow:0 10px 26px #b79db629}.hero h1{font-size:27px;margin:8px 0}.hero p{margin:0;line-height:1.5}.tabs{display:flex;gap:8px;margin:16px 0}.tabs button{flex:1;font-size:14px;padding:12px 6px}.btn,button{border:0;border-radius:16px;padding:13px 17px;background:#aa8de3;color:white;font-size:16px;font-weight:750;cursor:pointer}button:disabled{opacity:.5}.tabs button{background:#eee8f7;color:#6b5b8e}.tabs button.active{background:#9d7ed6;color:white}.card{background:white;padding:19px;border-radius:24px;box-shadow:0 8px 24px #bca9bc24;margin:15px 0}.card h2{font-size:20px;margin:0 0 12px}.muted{color:#82798c;font-size:14px;line-height:1.5}.answers{display:grid;gap:10px;margin-top:17px}.answer{background:#f4effc;color:#504265;text-align:left;font-weight:600}.answer.good{background:#d4f3df;color:#276344}.answer.bad{background:#ffe1e1;color:#9c3942}.room{background:linear-gradient(#f5e6d8 0 72%,#ddbb9e 72%);min-height:270px;border:8px solid #fff2e7;border-radius:22px;display:flex;align-items:center;justify-content:center;flex-wrap:wrap;gap:8px;padding:25px;margin:16px 0}.furniture{font-size:64px;filter:drop-shadow(0 7px 3px #7e5d5d2a)}.shopitem{display:flex;align-items:center;justify-content:space-between;gap:8px;border-bottom:1px solid #f0e9f2;padding:14px 0}.shopitem:last-child{border:0}.itemname{font-size:18px;font-weight:700}.small{font-size:13px}.hide{display:none}.notice{background:#e7f7ed;border-radius:14px;padding:12px;color:#286348;margin-top:12px}.footer{font-size:12px;text-align:center;color:#958aa0;margin-top:28px}
</style>
</head>
<body><main class="app">
<header class="top"><div><div class="logo">🏡 STUDY HOME</div><div class="tag">Навчайся • Заробляй • Прикрашай</div></div><div class="wallet">🪙 <span id="coins">0</span><br>⭐ <span id="xp">0</span> XP</div></header>
<section class="hero"><div>🌷 Твій затишний куточок</div><h1>Вчи ПДР — облаштовуй дім!</h1><p>Правильні відповіді дарують монетки. Витрачай їх на меблі для своєї кімнати.</p></section>
<nav class="tabs"><button id="tab-quiz" onclick="show('quiz')">📚 ПДР</button><button id="tab-home" onclick="show('home')">🏠 Мій дім</button><button id="tab-shop" onclick="show('shop')">🛍️ Магазин</button></nav>
<section id="quiz" class="card"><h2>🚦 Мінітест із ПДР</h2><p class="muted">5 навчальних запитань для демонстрації. Це не офіційний екзаменаційний банк.</p><div id="quizbody"></div></section>
<section id="home" class="card hide"><h2>🏠 Моя кімната</h2><p class="muted">Куплені меблі з'являються тут автоматично.</p><div class="room" id="room"></div><button onclick="show('shop')">Купити меблі 🛍️</button></section>
<section id="shop" class="card hide"><h2>🛍️ Магазин меблів</h2><p class="muted">Витрачай зароблені монетки на затишок.</p><div id="items"></div><div id="shopnotice"></div></section>
<div class="footer">Демонстраційна версія • Прогрес зберігається лише в цьому браузері на цьому пристрої</div>
</main>
<script>
const key='study-home-demo-v1';let state;try{state=JSON.parse(localStorage.getItem(key))}catch(e){}if(!state||typeof state.coins!=='number')state={coins:0,xp:0,owned:[]};
const questions=[
{q:'Який сигнал світлофора забороняє рух?',a:['Зелений','Червоний','Зелений миготливий'],correct:1,why:'Червоний сигнал забороняє рух.'},
{q:'Що потрібно зробити перед переходом дороги нерегульованим переходом?',a:['Переконатися, що перехід безпечний','Бігти не дивлячись','Дивитися лише в телефон'],correct:0,why:'Перед виходом на проїзну частину слід переконатися в безпеці.'},
{q:'Для чого призначений ремінь безпеки?',a:['Для прикраси салону','Для зменшення ризику травм','Для економії пального'],correct:1,why:'Ремінь безпеки допомагає захистити людину під час ДТП.'},
{q:'Що означає знак STOP?',a:['Зупинку без потреби можна пропустити','Обов’язково зупинитися','Збільшити швидкість'],correct:1,why:'Знак «Проїзд без зупинки заборонено» вимагає зупинки.'},
{q:'Чи можна користуватися телефоном у руці під час керування автомобілем?',a:['Так, завжди','Так, якщо дорога порожня','Ні'],correct:2,why:'Водію заборонено користуватися засобом зв’язку, тримаючи його в руці.'}
];
const catalog=[{id:'sofa',name:'М’який диван',emoji:'🛋️',price:20},{id:'lamp',name:'Лампа',emoji:'💡',price:15},{id:'plant',name:'Кімнатна рослина',emoji:'🪴',price:10},{id:'teddy',name:'Плюшевий ведмедик',emoji:'🧸',price:25},{id:'painting',name:'Картина',emoji:'🖼️',price:20}];
let index=0,selected=false,correctCount=0;
function save(){localStorage.setItem(key,JSON.stringify(state));document.getElementById('coins').textContent=state.coins;document.getElementById('xp').textContent=state.xp}
function show(page){for(const name of ['quiz','home','shop']){document.getElementById(name).classList.toggle('hide',name!==page);document.getElementById('tab-'+name).classList.toggle('active',name===page)}if(page==='home')renderRoom();if(page==='shop')renderShop()}
function renderQuiz(){let el=document.getElementById('quizbody');if(index>=questions.length){el.innerHTML=`<h2>🎉 Тест завершено!</h2><p>Правильних відповідей: <b>${correctCount} із ${questions.length}</b></p><p class="muted">За кожну правильну відповідь ти отримав(-ла) 10 монет і 5 XP.</p><button onclick="restart()">Пройти ще раз ↻</button>`;return}const q=questions[index];selected=false;el.innerHTML=`<p><b>Запитання ${index+1} / ${questions.length}</b></p><h2>${q.q}</h2><div class="answers">${q.a.map((answer,i)=>`<button class="answer" onclick="answer(${i})">${answer}</button>`).join('')}</div><div id="feedback"></div>`}
function answer(i){if(selected)return;selected=true;const q=questions[index],good=i===q.correct;document.querySelectorAll('.answer').forEach((b,j)=>{b.disabled=true;if(j===q.correct)b.classList.add('good');else if(j===i)b.classList.add('bad')});if(good){state.coins+=10;state.xp+=5;correctCount++;save()}document.getElementById('feedback').innerHTML=`<div class="notice">${good?'🎉 Правильно! +10 🪙 і +5 XP':'💡 Не зовсім. Спробуй запам’ятати правильну відповідь.'}<br>${q.why}</div><p><button onclick="next()">${index===questions.length-1?'Результат':'Наступне запитання →'}</button></p>`}
function next(){index++;renderQuiz()}function restart(){index=0;correctCount=0;renderQuiz()}
function renderRoom(){const room=document.getElementById('room');room.innerHTML=state.owned.length?state.owned.map(id=>`<span class="furniture" aria-label="меблі">${catalog.find(x=>x.id===id)?.emoji||''}</span>`).join(''):'<p style="text-align:center">🏠<br>Кімната ще порожня.<br>Завітай у магазин!</p>'}
function renderShop(){document.getElementById('items').innerHTML=catalog.map(x=>`<div class="shopitem"><div><span class="itemname">${x.emoji} ${x.name}</span><div class="muted small">🪙 ${x.price}</div></div><button ${state.owned.includes(x.id)||state.coins<x.price?'disabled':''} onclick="buy('${x.id}')">${state.owned.includes(x.id)?'Куплено': 'Купити'}</button></div>`).join('')}
function buy(id){const item=catalog.find(x=>x.id===id);if(!item||state.owned.includes(id)||state.coins<item.price)return;state.coins-=item.price;state.owned.push(id);save();renderShop();document.getElementById('shopnotice').innerHTML='<div class="notice">🎉 Покупка успішна! Перейди в «Мій дім».</div>'}
save();renderQuiz();show('quiz');
</script></body></html>
